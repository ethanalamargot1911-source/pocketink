<Window x:Class="PocketInk.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PocketInk.Host"
        mc:Ignorable="d"
        Title="PocketInk" Height="620" Width="900" MinHeight="560" MinWidth="820">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left column: pairing -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <TextBlock Text="Pair your iPhone" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
            <Border BorderBrush="#CCC" BorderThickness="1" Padding="8" Background="White" HorizontalAlignment="Left">
                <Image x:Name="QrImage" Width="220" Height="220" />
            </Border>
            <TextBlock Text="Scan with your iPhone's camera, on the same Wi-Fi network." TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#666" />

            <TextBlock Text="Network (for the QR code's address)" Margin="0,12,0,2" />
            <ComboBox x:Name="NetworkAdapterComboBox" DisplayMemberPath="Label" SelectionChanged="NetworkAdapterComboBox_SelectionChanged" />
            <TextBlock Text="If the phone can't reach this PC, pick the network it's actually connected through." Foreground="#666" Margin="0,4,0,0" TextWrapping="Wrap" />

            <TextBlock x:Name="PairedStatusText" Margin="0,16,0,0" FontWeight="Bold" />

            <Button x:Name="ForgetDeviceButton" Content="Forget paired iPhone" Margin="0,16,0,4" Padding="6" Click="ForgetDeviceButton_Click" />
            <Button x:Name="RefreshQrButton" Content="Refresh pairing QR" Margin="0,0,0,4" Padding="6" Click="RefreshQrButton_Click" />

            <Separator Margin="0,16,0,16" />

            <TextBlock Text="Pair remotely (cross-network)" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
            <TextBlock Text="For when the phone isn't on this PC's Wi-Fi. Requires a one-time Supabase + hosting setup." TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,8" />

            <GroupBox Header="Remote setup" Padding="8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Supabase project URL" Margin="0,0,0,2" />
                    <TextBox x:Name="SupabaseUrlTextBox" Margin="0,0,0,8" LostFocus="RemoteSettingsTextBox_LostFocus" />

                    <TextBlock Text="Supabase anon/publishable key" Margin="0,0,0,2" />
                    <TextBox x:Name="SupabaseAnonKeyTextBox" Margin="0,0,0,8" LostFocus="RemoteSettingsTextBox_LostFocus" />

                    <TextBlock Text="Remote client URL (e.g. GitHub Pages)" Margin="0,0,0,2" />
                    <TextBox x:Name="RemoteClientBaseUrlTextBox" Margin="0,0,0,8" LostFocus="RemoteSettingsTextBox_LostFocus" />

                    <TextBlock Text="TURN server URL(s) - semicolon-separated, optional but recommended" Margin="0,0,0,2" TextWrapping="Wrap" />
                    <TextBox x:Name="TurnServerUrlsTextBox" Margin="0,0,0,8" LostFocus="RemoteSettingsTextBox_LostFocus" />

                    <TextBlock Text="TURN username" Margin="0,0,0,2" />
                    <TextBox x:Name="TurnUsernameTextBox" Margin="0,0,0,8" LostFocus="RemoteSettingsTextBox_LostFocus" />

                    <TextBlock Text="TURN credential" Margin="0,0,0,2" />
                    <TextBox x:Name="TurnCredentialTextBox" LostFocus="RemoteSettingsTextBox_LostFocus" />
                </StackPanel>
            </GroupBox>

            <Border x:Name="RemoteQrBorder" BorderBrush="#CCC" BorderThickness="1" Padding="8" Background="White" HorizontalAlignment="Left" Visibility="Collapsed">
                <Image x:Name="RemoteQrImage" Width="220" Height="220" />
            </Border>
            <TextBlock x:Name="RemoteStatusText" TextWrapping="Wrap" Margin="0,8,0,8" Foreground="#666" />

            <Button x:Name="StartRemotePairingButton" Content="Generate remote pairing QR" Margin="0,0,0,4" Padding="6" Click="StartRemotePairingButton_Click" />
            <Button x:Name="CancelRemotePairingButton" Content="Cancel remote pairing" Padding="6" Click="CancelRemotePairingButton_Click" IsEnabled="False" />
            </StackPanel>
        </ScrollViewer>

        <!-- Right column: connection, settings, metrics, safety controls -->
        <StackPanel Grid.Column="2">
            <TextBlock x:Name="ConnectionStatusText" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />

            <GroupBox Header="Settings" Padding="8" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Target monitor" Margin="0,0,0,2" />
                    <ComboBox x:Name="MonitorComboBox" DisplayMemberPath="Name" SelectionChanged="MonitorComboBox_SelectionChanged" Margin="0,0,0,8" />

                    <TextBlock Text="Pressure mode" Margin="0,0,0,2" />
                    <ComboBox x:Name="PressureModeComboBox" SelectionChanged="PressureModeComboBox_SelectionChanged" Margin="0,0,0,8" />

                    <TextBlock x:Name="ConstantPressureLabel" Text="Constant pressure: 60%" Margin="0,0,0,2" />
                    <Slider x:Name="ConstantPressureSlider" Minimum="0" Maximum="1" ValueChanged="ConstantPressureSlider_ValueChanged" Margin="0,0,0,8" />

                    <TextBlock Text="Smoothing (applies to new connections)" Margin="0,0,0,2" />
                    <ComboBox x:Name="SmoothingComboBox" SelectionChanged="SmoothingComboBox_SelectionChanged" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Session metrics (live)" Padding="8" Margin="0,0,0,12">
                <TextBlock x:Name="MetricsText" FontFamily="Consolas" TextWrapping="Wrap" />
            </GroupBox>

            <GroupBox Header="Diagnostics" Padding="8" Margin="0,0,0,12">
                <StackPanel>
                    <Button x:Name="TestPenButton" Content="Test Pen (draws a short stroke)" Padding="6" Click="TestPenButton_Click" />
                    <TextBlock Text="Focus a drawing app on the target monitor first." Foreground="#666" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>

            <Button x:Name="StopInputButton" Content="STOP INPUT" Height="56" FontSize="18" FontWeight="Bold"
                    Background="#C62828" Foreground="White" Click="StopInputButton_Click" />
        </StackPanel>
    </Grid>
</Window>
